# Copy this file to .env.local on your laptop and fill in the values.
# On the live site, put the same names in Railway: your service, then Variables.
# Never commit real values. .gitignore blocks every .env file except this one.

# Database for the enquiries. In Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Admin login at /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random text, at least 32 characters. Signs the login cookie.
SESSION_SECRET=

# Emails (Task 4, not used yet)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
