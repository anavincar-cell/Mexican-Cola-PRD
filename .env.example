# Copy this file to .env.local on your laptop and fill in the values.
# On the live site, put the same names in Railway: your service, then Variables.
# Never commit real values. .gitignore blocks every .env file except this one.

# Database for the enquiries. In Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# First admin user. Used once on the first start: the password is saved hashed
# in the database. Then delete ADMIN_PASSWORD. Add more admins at /admin/users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Forgot your password? Set ADMIN_PASSWORD to a new one and this to true, redeploy,
# log in, then delete both.
ADMIN_RESET_PASSWORD=
# Random text, at least 32 characters. Signs the login cookie.
SESSION_SECRET=

# Emails through Mailgun: a thank-you to the visitor and an alert to you.
# The API key is a secret: only in .env.local and Railway Variables, never in the code.
MAILGUN_API_KEY=
# For example sandbox123.mailgun.org
MAILGUN_DOMAIN=
# eu or us, the region of your Mailgun account. Empty: US is tried first, then EU.
MAILGUN_REGION=
# Who gets the new-enquiry alert. Empty: ADMIN_EMAIL.
NOTIFY_EMAIL=

# Google Analytics 4 Measurement ID, for example G-AB12CD34EF. Not secret, but kept
# out of the code like the other settings. Empty: no Google Analytics and no cookie banner.
GA_MEASUREMENT_ID=
